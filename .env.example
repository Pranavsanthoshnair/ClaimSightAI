# Copy to .env and fill in your API key.
# .env is gitignored — never commit secrets.

# Provider selection: gemini | openai | anthropic | none
MODEL_PROVIDER=gemini

# Gemini (recommended — Gemini 2.5 Flash is the default)
GEMINI_API_KEY=your_gemini_api_key_here
VISION_MODEL=gemini-2.5-flash
TEXT_MODEL=gemini-2.5-flash

# OpenRouter fallback — 3-tier chain: Tier1=Gemini → Tier2=Qwen2.5-VL → Tier3=LLaMA
# When Gemini hits 429/503, Tier 2 is tried; if that fails, Tier 3 is tried.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_TIER2=qwen/qwen2.5-vl-72b-instruct
OPENROUTER_MODEL_TIER3=meta-llama/llama-3.2-90b-vision-instruct

# OpenAI (alternative primary)
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# VISION_MODEL=gpt-4o

# Anthropic (alternative primary)
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# VISION_MODEL=claude-3-5-sonnet-20241022
