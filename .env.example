# ClaimSight AI — Provider Configuration
# Copy to .env and fill in your API keys.
# .env is gitignored — never commit secrets.

# ── OpenRouter (required for all vision analysis) ──────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vision model tier hierarchy (OpenRouter model slugs)
# Tier 1 — Primary: Qwen2.5-VL 72B (strongest general-purpose VLM on OpenRouter)
OPENROUTER_MODEL_PRIMARY=qwen/qwen2.5-vl-72b-instruct

# Tier 2 — Secondary: Llama 3.2 90B Vision (Meta's flagship vision model)
OPENROUTER_MODEL_SECONDARY=meta-llama/llama-3.2-90b-vision-instruct

# Tier 3 — Tertiary: Pixtral Large 124B (Mistral's frontier VLM, 128K context)
OPENROUTER_MODEL_TERTIARY=mistralai/pixtral-large-2411

# ── Groq (optional — text reasoning fallback only) ──────────────────────────────
# Used ONLY when ALL OpenRouter vision providers fail.
# Groq does NOT perform image understanding — text/structured reasoning only.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
