# ─────────────────────────────────────────────────────────────────────────────
# ClaimSight AI — Streamlit Cloud Secrets TEMPLATE
# Copy this file content into: share.streamlit.io → App → Settings → Secrets
# Replace all placeholder values with your real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenRouter key pool (up to 5 keys — rotated instantly on 402/429) ─────────
# Get keys at https://openrouter.ai/keys
OPENROUTER_API_KEY   = "sk-or-v1-YOUR_PRIMARY_KEY"
OPENROUTER_API_KEY_2 = "sk-or-v1-YOUR_KEY_2"
OPENROUTER_API_KEY_3 = "sk-or-v1-YOUR_KEY_3"
OPENROUTER_API_KEY_4 = "sk-or-v1-YOUR_KEY_4"
OPENROUTER_API_KEY_5 = "sk-or-v1-YOUR_KEY_5"

# ── Vision model tier hierarchy ────────────────────────────────────────────────
# T1: fastest/cheapest vision model
OPENROUTER_MODEL_PRIMARY   = "meta-llama/llama-3.2-11b-vision-instruct"
# T2: fallback
OPENROUTER_MODEL_SECONDARY = "anthropic/claude-3-haiku"
# T3: last resort
OPENROUTER_MODEL_TERTIARY  = "qwen/qwen2.5-vl-72b-instruct"

# ── Groq (optional — text reasoning fallback only, not vision) ────────────────
# Leave blank if not using Groq
GROQ_API_KEY = ""
GROQ_MODEL   = "llama-3.1-8b-instant"
